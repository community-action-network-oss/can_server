{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "contribution.interpretation",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "target",
    "claim",
    "basis",
    "evidence_refs",
    "uncertainty",
    "assumptions",
    "reading_of",
    "alternatives_considered"
  ],
  "properties": {
    "type": {
      "const": "interpretation",
      "x-ui": {
        "widget": "hidden",
        "label_msg": "schema.contribution.common.type.label",
        "order": 1,
        "group": "claim"
      },
      "x-guidance": {
        "why": "Fixed by the form the person opened.",
        "good": "interpretation",
        "bad": "other"
      }
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "x-ui": {
        "widget": "ref",
        "label_msg": "schema.contribution.common.target.label",
        "help_msg": "schema.contribution.common.target.help",
        "order": 2,
        "group": "claim"
      },
      "x-guidance": {
        "why": "Says what this contribution answers: a problem, a task or another contribution.",
        "good": "prob-lights-0042",
        "bad": "the thing above"
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE"
        ]
      }
    },
    "claim": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.contribution.common.claim.label",
        "help_msg": "schema.contribution.common.claim.help",
        "order": 3,
        "group": "claim"
      },
      "x-guidance": {
        "why": "One clear statement the public can read, check and answer.",
        "good": "The lights on the north ring road have been out for several weeks.",
        "bad": "It is all broken.",
        "min_chars": 20,
        "max_chars": 500,
        "limits_key": "fields.contribution.interpretation.claim"
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "basis": {
      "enum": [
        "firsthand",
        "cited",
        "inferred"
      ],
      "x-ui": {
        "widget": "select",
        "label_msg": "schema.contribution.common.basis.label",
        "help_msg": "schema.contribution.common.basis.help",
        "order": 4,
        "group": "grounds"
      },
      "x-guidance": {
        "why": "Shows whether the claim was seen first hand, taken from a source or reasoned out.",
        "good": "firsthand",
        "bad": "sure"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "supports"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 9,
            "maxLength": 300,
            "pattern": "^https?://\\S+$",
            "x-ui": {
              "widget": "url",
              "label_msg": "schema.contribution.common.evidence_refs.url.label",
              "help_msg": "schema.contribution.common.evidence_refs.url.help",
              "order": 1
            }
          },
          "supports": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.contribution.common.evidence_refs.supports.label",
              "help_msg": "schema.contribution.common.evidence_refs.supports.help",
              "order": 2
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.contribution.common.evidence_refs.label",
        "help_msg": "schema.contribution.common.evidence_refs.help",
        "order": 5,
        "group": "grounds"
      },
      "x-guidance": {
        "why": "A link is not proof, so each one says what it supports.",
        "good": "Council repair log, supports the claim that the fault was reported.",
        "bad": "See link."
      },
      "x-checks": {
        "dps": [
          "DP-EVIDENCE-TIER",
          "DP-PRIVACY"
        ]
      }
    },
    "uncertainty": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.contribution.common.uncertainty.label",
        "help_msg": "schema.contribution.common.uncertainty.help",
        "order": 6,
        "group": "doubts"
      },
      "x-guidance": {
        "why": "Says what is not known so readers can weigh the claim.",
        "good": "I do not know how many lights are affected.",
        "bad": "None.",
        "min_chars": 5,
        "max_chars": 300
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.contribution.common.assumptions.label",
        "help_msg": "schema.contribution.common.assumptions.help",
        "order": 7,
        "group": "doubts"
      },
      "x-guidance": {
        "why": "Saying what you take for granted lets others check it.",
        "good": "I assume the lights share one power feed.",
        "bad": "No assumptions."
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "reading_of": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.contribution.interpretation.reading_of.label",
        "help_msg": "schema.contribution.interpretation.reading_of.help",
        "order": 10,
        "group": "details"
      },
      "x-guidance": {
        "why": "Says what is being read, so the reading can be checked.",
        "good": "The repair log and the evening count taken together.",
        "bad": "Everything.",
        "min_chars": 10,
        "max_chars": 300
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 300
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.contribution.interpretation.alternatives_considered.label",
        "help_msg": "schema.contribution.interpretation.alternatives_considered.help",
        "order": 11,
        "group": "details"
      },
      "x-guidance": {
        "why": "A reading is stronger when other readings were weighed.",
        "good": "The lights may be off for planned maintenance.",
        "bad": "None."
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-CRISIS",
          "DP-ASSUMPTIONS",
          "DP-COMPLETENESS"
        ]
      }
    }
  },
  "x-checks": {
    "dps": [
      "DP-CONTRIB-RELEVANCE",
      "DP-PRIVACY",
      "DP-NAMING",
      "DP-TONE",
      "DP-CRISIS",
      "DP-ASSUMPTIONS",
      "DP-COMPLETENESS"
    ]
  }
}
