{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "verification",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_ref",
    "final_criterion_refs",
    "success_metric_restated",
    "evidence_refs",
    "outcomes",
    "what_the_evidence_does_not_show"
  ],
  "properties": {
    "stage_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$",
      "minLength": 2,
      "maxLength": 40,
      "x-ui": {
        "widget": "stage_ref",
        "label_msg": "schema.verification.stage_ref.label",
        "help_msg": "schema.verification.stage_ref.help",
        "order": 1,
        "group": "stage"
      },
      "x-guidance": {
        "why": "Ties this to one stage so it is read against that stage's goal and criteria.",
        "good": "design_prevention",
        "bad": "the second one"
      },
      "x-checks": {
        "dps": [
          "DP-STAGE-RESOLUTION"
        ],
        "ref_to": "problem.stage_plan.name"
      }
    },
    "final_criterion_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 6,
        "x-ui": {
          "widget": "criterion_ref",
          "label_msg": "schema.verification.final_criterion_refs.item.label",
          "help_msg": "schema.verification.final_criterion_refs.item.help",
          "order": 0
        },
        "x-guidance": {
          "why": "The position (1 to 6) of one final acceptance criterion.",
          "good": "2",
          "bad": "all of them"
        },
        "x-checks": {
          "dps": [
            "DP-VERIFICATION"
          ],
          "ref_to": "problem.stage_plan.acceptance_criteria",
          "one_based_position": true
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.verification.final_criterion_refs.label",
        "help_msg": "schema.verification.final_criterion_refs.help",
        "order": 2,
        "group": "criteria"
      },
      "x-guidance": {
        "why": "Lists each final acceptance criterion this check judges.",
        "good": "1, 2",
        "bad": "everything"
      },
      "x-checks": {
        "dps": [
          "DP-VERIFICATION"
        ],
        "ref_to": "problem.stage_plan.acceptance_criteria",
        "one_based_position": true
      }
    },
    "success_metric_restated": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.verification.success_metric_restated.label",
        "help_msg": "schema.verification.success_metric_restated.help",
        "order": 3,
        "group": "criteria"
      },
      "x-guidance": {
        "why": "Restates the measure so the evidence is read against it.",
        "good": "No reported outage on the ring road for 30 days.",
        "bad": "Better lights.",
        "min_chars": 10,
        "max_chars": 300,
        "limits_key": "fields.verification.success_metric_restated"
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-VERIFICATION"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "description"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 9,
            "maxLength": 300,
            "pattern": "^https?://\\S+$",
            "x-ui": {
              "widget": "evidence_url",
              "label_msg": "schema.verification.evidence_refs.url.label",
              "help_msg": "schema.verification.evidence_refs.url.help",
              "order": 1
            },
            "x-checks": {
              "dps": [
                "DP-EVIDENCE-TIER",
                "DP-SOURCE-TRUST",
                "DP-PRIVACY"
              ],
              "no_uploads_of_people": true
            }
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.verification.evidence_refs.description.label",
              "help_msg": "schema.verification.evidence_refs.description.help"
            }
          },
          "tier_request": {
            "enum": [
              "official_record",
              "statistics_body",
              "court_or_legislature",
              "reputable_media",
              "research",
              "civil_society",
              "firsthand",
              "other"
            ],
            "x-ui": {
              "widget": "select",
              "label_msg": "schema.verification.evidence_refs.tier_request.label",
              "help_msg": "schema.verification.evidence_refs.tier_request.help"
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.verification.evidence_refs.label",
        "help_msg": "schema.verification.evidence_refs.help",
        "order": 4,
        "group": "evidence"
      },
      "x-guidance": {
        "why": "A link is not proof, so each one says what it is and which kind of source it comes from.",
        "good": "Council repair log, shows the ring road feed repaired on 3 March.",
        "bad": "See link."
      },
      "x-checks": {
        "dps": [
          "DP-EVIDENCE-TIER",
          "DP-SOURCE-TRUST",
          "DP-PRIVACY"
        ],
        "source_trust": "SOURCE-1"
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_ref",
          "outcome_statement"
        ],
        "properties": {
          "criterion_ref": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "x-ui": {
              "widget": "criterion_ref",
              "label_msg": "schema.verification.outcomes.criterion_ref.label",
              "help_msg": "schema.verification.outcomes.criterion_ref.help"
            }
          },
          "outcome_statement": {
            "type": "string",
            "minLength": 20,
            "maxLength": 500,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.verification.outcomes.outcome_statement.label",
              "help_msg": "schema.verification.outcomes.outcome_statement.help"
            },
            "x-guidance": {
              "why": "Says what the evidence showed for that criterion, in plain words.",
              "good": "No outage was logged on the ring road for 31 days after the repair.",
              "bad": "It worked.",
              "min_chars": 20,
              "max_chars": 500
            },
            "x-checks": {
              "dps": [
                "DP-PRIVACY",
                "DP-NAMING",
                "DP-TONE",
                "DP-VERIFICATION"
              ]
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.verification.outcomes.label",
        "help_msg": "schema.verification.outcomes.help",
        "order": 5,
        "group": "outcome"
      },
      "x-guidance": {
        "why": "One outcome for each final criterion, so none is skipped.",
        "good": "Criterion 1: no outage in 31 days.",
        "bad": "All good."
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-VERIFICATION"
        ],
        "covers": "final_criterion_refs"
      }
    },
    "what_the_evidence_does_not_show": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.verification.what_the_evidence_does_not_show.label",
        "help_msg": "schema.verification.what_the_evidence_does_not_show.help",
        "order": 6,
        "group": "evidence"
      },
      "x-guidance": {
        "why": "Keeps the claim honest about what the evidence cannot show.",
        "good": "It covers the ring road only, not the side streets.",
        "bad": "Nothing.",
        "min_chars": 10,
        "max_chars": 300,
        "limits_key": "fields.verification.what_the_evidence_does_not_show"
      },
      "x-checks": {
        "dps": [
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE",
          "DP-VERIFICATION",
          "DP-EVIDENCE-TIER"
        ]
      }
    }
  },
  "x-checks": {
    "dps": [
      "DP-PRIVACY",
      "DP-NAMING",
      "DP-TONE",
      "DP-VERIFICATION",
      "DP-EVIDENCE-TIER",
      "DP-SOURCE-TRUST",
      "DP-STAGE-RESOLUTION"
    ],
    "masked_refs_only": true,
    "url_only": true
  }
}
