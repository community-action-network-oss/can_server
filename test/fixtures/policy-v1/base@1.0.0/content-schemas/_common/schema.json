{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "_common",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "$comment": "Not a content type. Holds the shared contribution fields. Each contribution.<type> schema carries an inlined copy and test/schema-contribution-a.test.mjs checks the copies match.",
  "type": "object",
  "$defs": {
    "contribution_common": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "x-ui": {
            "widget": "ref",
            "label_msg": "schema.contribution.common.target.label",
            "help_msg": "schema.contribution.common.target.help",
            "order": 2,
            "group": "claim"
          },
          "x-guidance": {
            "why": "Says what this contribution answers: a problem, a task or another contribution.",
            "good": "prob-lights-0042",
            "bad": "the thing above"
          },
          "x-checks": {
            "dps": [
              "DP-CONTRIB-RELEVANCE"
            ]
          }
        },
        "claim": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.contribution.common.claim.label",
            "help_msg": "schema.contribution.common.claim.help",
            "order": 3,
            "group": "claim"
          },
          "x-guidance": {
            "why": "One clear statement the public can read, check and answer.",
            "good": "The lights on the north ring road have been out for several weeks.",
            "bad": "It is all broken.",
            "min_chars": 20,
            "max_chars": 500,
            "limits_key": "fields.contribution.CLAIMKEY.claim"
          },
          "x-checks": {
            "dps": [
              "DP-CONTRIB-RELEVANCE",
              "DP-PRIVACY",
              "DP-NAMING",
              "DP-TONE",
              "DP-CRISIS",
              "DP-ASSUMPTIONS",
              "DP-COMPLETENESS"
            ]
          }
        },
        "basis": {
          "enum": [
            "firsthand",
            "cited",
            "inferred"
          ],
          "x-ui": {
            "widget": "select",
            "label_msg": "schema.contribution.common.basis.label",
            "help_msg": "schema.contribution.common.basis.help",
            "order": 4,
            "group": "grounds"
          },
          "x-guidance": {
            "why": "Shows whether the claim was seen first hand, taken from a source or reasoned out.",
            "good": "firsthand",
            "bad": "sure"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "supports"
            ],
            "properties": {
              "url": {
                "type": "string",
                "minLength": 9,
                "maxLength": 300,
                "pattern": "^https?://\\S+$",
                "x-ui": {
                  "widget": "url",
                  "label_msg": "schema.contribution.common.evidence_refs.url.label",
                  "help_msg": "schema.contribution.common.evidence_refs.url.help",
                  "order": 1
                }
              },
              "supports": {
                "type": "string",
                "minLength": 10,
                "maxLength": 300,
                "x-ui": {
                  "widget": "textarea",
                  "label_msg": "schema.contribution.common.evidence_refs.supports.label",
                  "help_msg": "schema.contribution.common.evidence_refs.supports.help",
                  "order": 2
                }
              }
            }
          },
          "x-ui": {
            "widget": "list",
            "label_msg": "schema.contribution.common.evidence_refs.label",
            "help_msg": "schema.contribution.common.evidence_refs.help",
            "order": 5,
            "group": "grounds"
          },
          "x-guidance": {
            "why": "A link is not proof, so each one says what it supports.",
            "good": "Council repair log, supports the claim that the fault was reported.",
            "bad": "See link."
          },
          "x-checks": {
            "dps": [
              "DP-EVIDENCE-TIER",
              "DP-PRIVACY"
            ]
          }
        },
        "uncertainty": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.contribution.common.uncertainty.label",
            "help_msg": "schema.contribution.common.uncertainty.help",
            "order": 6,
            "group": "doubts"
          },
          "x-guidance": {
            "why": "Says what is not known so readers can weigh the claim.",
            "good": "I do not know how many lights are affected.",
            "bad": "None.",
            "min_chars": 5,
            "max_chars": 300
          },
          "x-checks": {
            "dps": [
              "DP-CONTRIB-RELEVANCE",
              "DP-PRIVACY",
              "DP-NAMING",
              "DP-TONE",
              "DP-CRISIS",
              "DP-ASSUMPTIONS",
              "DP-COMPLETENESS"
            ]
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "x-ui": {
            "widget": "list",
            "label_msg": "schema.contribution.common.assumptions.label",
            "help_msg": "schema.contribution.common.assumptions.help",
            "order": 7,
            "group": "doubts"
          },
          "x-guidance": {
            "why": "Saying what you take for granted lets others check it.",
            "good": "I assume the lights share one power feed.",
            "bad": "No assumptions."
          },
          "x-checks": {
            "dps": [
              "DP-CONTRIB-RELEVANCE",
              "DP-PRIVACY",
              "DP-NAMING",
              "DP-TONE",
              "DP-CRISIS",
              "DP-ASSUMPTIONS",
              "DP-COMPLETENESS"
            ]
          }
        }
      }
    }
  }
}
