{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "stage_evidence",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage_ref",
    "criterion_ref",
    "evidence_refs",
    "observation_date",
    "outcome_statement",
    "what_the_evidence_does_not_show"
  ],
  "properties": {
    "stage_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,39}$",
      "minLength": 2,
      "maxLength": 40,
      "x-ui": {
        "widget": "stage_ref",
        "label_msg": "schema.stage_evidence.stage_ref.label",
        "help_msg": "schema.stage_evidence.stage_ref.help",
        "order": 1,
        "group": "stage"
      },
      "x-guidance": {
        "why": "Ties this to one stage so it is read against that stage's goal and criteria.",
        "good": "design_prevention",
        "bad": "the second one"
      },
      "x-checks": {
        "dps": [
          "DP-CONTRIB-RELEVANCE"
        ],
        "ref_to": "problem.stage_plan.name"
      }
    },
    "criterion_ref": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "x-ui": {
        "widget": "criterion_ref",
        "label_msg": "schema.stage_evidence.criterion_ref.label",
        "help_msg": "schema.stage_evidence.criterion_ref.help",
        "order": 2,
        "group": "stage"
      },
      "x-guidance": {
        "why": "The position (1 to 6) of one acceptance criterion in the stage's list.",
        "good": "2",
        "bad": "all of them"
      },
      "x-checks": {
        "dps": [
          "DP-STAGE-RESOLUTION"
        ],
        "ref_to": "problem.stage_plan.acceptance_criteria",
        "one_based_position": true
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "description"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 9,
            "maxLength": 300,
            "pattern": "^https?://\\S+$",
            "x-ui": {
              "widget": "evidence_url",
              "label_msg": "schema.stage_evidence.evidence_refs.url.label",
              "help_msg": "schema.stage_evidence.evidence_refs.url.help",
              "order": 1
            },
            "x-checks": {
              "dps": [
                "DP-EVIDENCE-TIER",
                "DP-SOURCE-TRUST",
                "DP-PRIVACY"
              ],
              "no_uploads_of_people": true
            }
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "x-ui": {
              "widget": "textarea",
              "label_msg": "schema.stage_evidence.evidence_refs.description.label",
              "help_msg": "schema.stage_evidence.evidence_refs.description.help"
            }
          },
          "tier_request": {
            "enum": [
              "official_record",
              "statistics_body",
              "court_or_legislature",
              "reputable_media",
              "research",
              "civil_society",
              "firsthand",
              "other"
            ],
            "x-ui": {
              "widget": "select",
              "label_msg": "schema.stage_evidence.evidence_refs.tier_request.label",
              "help_msg": "schema.stage_evidence.evidence_refs.tier_request.help"
            }
          }
        }
      },
      "x-ui": {
        "widget": "list",
        "label_msg": "schema.stage_evidence.evidence_refs.label",
        "help_msg": "schema.stage_evidence.evidence_refs.help",
        "order": 3,
        "group": "evidence"
      },
      "x-guidance": {
        "why": "A link is not proof, so each one says what it is and which kind of source it comes from.",
        "good": "Council repair log, shows the ring road feed repaired on 3 March.",
        "bad": "See link."
      },
      "x-checks": {
        "dps": [
          "DP-EVIDENCE-TIER",
          "DP-SOURCE-TRUST",
          "DP-PRIVACY"
        ],
        "source_trust": "SOURCE-1"
      }
    },
    "observation_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-ui": {
        "widget": "date",
        "label_msg": "schema.stage_evidence.observation_date.label",
        "help_msg": "schema.stage_evidence.observation_date.help",
        "order": 4,
        "group": "evidence"
      },
      "x-guidance": {
        "why": "A date written year-month-day.",
        "good": "2026-03-14",
        "bad": "last week"
      }
    },
    "outcome_statement": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.stage_evidence.outcome_statement.label",
        "help_msg": "schema.stage_evidence.outcome_statement.help",
        "order": 5,
        "group": "outcome"
      },
      "x-guidance": {
        "why": "States the result against the criterion so DP-STAGE-RESOLUTION can judge it.",
        "good": "The log shows no outage report on the ring road for 31 days after the repair.",
        "bad": "It worked.",
        "min_chars": 20,
        "max_chars": 500,
        "limits_key": "fields.stage_evidence.outcome_statement"
      },
      "x-checks": {
        "dps": [
          "DP-STAGE-RESOLUTION",
          "DP-CONTRIB-RELEVANCE",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE"
        ]
      }
    },
    "what_the_evidence_does_not_show": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "x-ui": {
        "widget": "textarea",
        "label_msg": "schema.stage_evidence.what_the_evidence_does_not_show.label",
        "help_msg": "schema.stage_evidence.what_the_evidence_does_not_show.help",
        "order": 6,
        "group": "outcome"
      },
      "x-guidance": {
        "why": "The limits of this evidence.",
        "good": "It covers the ring road only, not the side streets.",
        "bad": "Nothing.",
        "min_chars": 10,
        "max_chars": 300,
        "limits_key": "fields.stage_evidence.what_the_evidence_does_not_show"
      },
      "x-checks": {
        "dps": [
          "DP-STAGE-RESOLUTION",
          "DP-ASSUMPTIONS",
          "DP-PRIVACY",
          "DP-NAMING",
          "DP-TONE"
        ]
      }
    }
  },
  "x-checks": {
    "dps": [
      "DP-STAGE-RESOLUTION",
      "DP-EVIDENCE-TIER",
      "DP-SOURCE-TRUST",
      "DP-PRIVACY",
      "DP-NAMING",
      "DP-TONE",
      "DP-CONTRIB-RELEVANCE"
    ],
    "url_only": true
  }
}
