{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "contribution.proposal_improvement",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "target",
    "claim",
    "basis",
    "evidence_refs",
    "uncertainty",
    "assumptions",
    "improves",
    "change",
    "mechanism",
    "responsible_role",
    "authority",
    "cost",
    "success_metric",
    "risks",
    "lawful_alternatives"
