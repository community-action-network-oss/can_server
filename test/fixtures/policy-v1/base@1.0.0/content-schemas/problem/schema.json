{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "problem",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "condition",
    "affected",
    "place",
    "since",
    "observed_facts",
    "uncertain_claims",
    "sources",
    "evidence_refs",
    "causal_hypothesis",
