{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "_shared",
  "version": "1.0.0",
  "x-version": "1.0.0",
  "pack": "base@1.0.0",
  "$comment": "Not a content type. Holds criterion and stage_node. The problem schema carries an inlined copy under $defs; test/schema-problem-v2.test.mjs fails if they drift. bands.json is the band scale file.",
  "type": "object",
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "measure"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.problem.stage_plan.criterion.statement.label",
            "help_msg": "schema.problem.stage_plan.criterion.statement.help"
          }
        },
        "measure": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.problem.stage_plan.criterion.measure.label",
            "help_msg": "schema.problem.stage_plan.criterion.measure.help"
          }
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-ui": {
            "widget": "text",
            "label_msg": "schema.problem.stage_plan.criterion.target.label",
            "help_msg": "schema.problem.stage_plan.criterion.target.help"
          }
        },
        "evidence_hint": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.problem.stage_plan.criterion.evidence_hint.label",
            "help_msg": "schema.problem.stage_plan.criterion.evidence_hint.help"
          }
        },
        "deadline": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10,
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "x-ui": {
            "widget": "date",
            "label_msg": "schema.problem.stage_plan.criterion.deadline.label",
            "help_msg": "schema.problem.stage_plan.criterion.deadline.help"
          }
        }
      }
    },
    "stage_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "goal",
        "acceptance_criteria"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9_]{1,39}$",
          "x-ui": {
            "widget": "text",
            "label_msg": "schema.problem.stage_plan.stage.name.label",
            "help_msg": "schema.problem.stage_plan.stage.name.help"
          }
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "x-ui": {
            "widget": "text",
            "label_msg": "schema.problem.stage_plan.stage.label.label",
            "help_msg": "schema.problem.stage_plan.stage.label.help"
          }
        },
        "goal": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "x-ui": {
            "widget": "textarea",
            "label_msg": "schema.problem.stage_plan.stage.goal.label",
            "help_msg": "schema.problem.stage_plan.stage.goal.help"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "x-ui": {
            "widget": "list",
            "label_msg": "schema.problem.stage_plan.stage.acceptance_criteria.label",
            "help_msg": "schema.problem.stage_plan.stage.acceptance_criteria.help"
          }
        },
        "decision_method": {
          "type": "string",
          "enum": [
            "poster_after_input",
            "community_vote",
            "steward",
            "other_named"
          ],
          "default": "poster_after_input",
          "x-ui": {
            "widget": "select",
            "label_msg": "schema.problem.stage_plan.stage.decision_method.label",
            "help_msg": "schema.problem.stage_plan.stage.decision_method.help"
          }
        },
        "depends_on": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "x-ui": {
            "widget": "list",
            "label_msg": "schema.problem.stage_plan.stage.depends_on.label",
            "help_msg": "schema.problem.stage_plan.stage.depends_on.help"
          }
        },
        "required": {
          "type": "boolean",
          "default": true,
          "x-ui": {
            "widget": "toggle",
            "label_msg": "schema.problem.stage_plan.stage.required.label"
          }
        },
        "needs_choice": {
          "type": "boolean",
          "default": true,
          "x-ui": {
            "widget": "toggle",
            "label_msg": "schema.problem.stage_plan.stage.needs_choice.label"
          }
        },
        "auto_start": {
          "type": "boolean",
          "default": true,
          "x-ui": {
            "widget": "toggle",
            "label_msg": "schema.problem.stage_plan.stage.auto_start.label"
          }
        }
      },
      "x-checks": {
        "unique_names": true,
        "depends_on_resolves": true,
        "acyclic": "DP-STAGE-PLAN"
      }
    }
  }
}
