{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "can_policy/decision-points/DP-ARCHIVE/schema.json",
  "$comment": "Extends schemas/dp-output.schema.json: the shared keys are unchanged except outcome, which is narrowed. Unsafe outputs are unrepresentable: a record is public only on publish, which needs ARCHIVE-1, confidence 0.90 or more, residual_personal_data false, failures_explained and blocked_explained true and no missing items; residual_personal_data true forces hold; needs_revision names what is missing; missing, unreadable or unsure input is a hold. There is no reject outcome and no auto-pass. JSON Schema cannot compare against the input: the handler checks that every finding field of the server (finding f-N meta) appears in missing on a needs_revision, that missing refs are input refs, and that a publish is refused unless the input completeness_check is passed, privacy_restrip is done and the terminal_state is archivable; any mismatch is a hold (see eval/README.md).",
  "title": "DP-ARCHIVE output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "rule_ids",
    "confidence",
    "reasons"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "publish",
        "needs_revision",
        "hold"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "revision_hint": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_personal_data": {
      "type": "boolean"
    },
    "failures_explained": {
      "type": "boolean"
    },
    "blocked_explained": {
      "type": "boolean"
    },
    "missing": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "hint"
        ],
        "properties": {
          "field": {
            "enum": [
              "executed_path",
              "stage_outcome",
              "bands",
              "costs",
              "versions",
              "evidence_refs",
              "evidence_strength",
              "challenges",
              "failure_reasons",
              "blocked_explanation",
              "outcome",
              "attribution",
              "instruction_like_text",
              "hidden_text",
              "link_farm"
            ]
          },
          "ref": {
            "type": "string",
            "pattern": "^(s|c|e|f)-[0-9]{1,3}$"
          },
          "hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
          }
        }
      }
    },
    "hold_reason": {
      "enum": [
        "missing_input",
        "ambiguous_input",
        "residual_personal_data",
        "cannot_decide"
      ]
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "jurisdiction",
          "trigger",
          "terminal_state",
          "privacy_restrip",
          "completeness_check",
          "finding_lines",
          "stage_count",
          "stage_lines",
          "challenge_count",
          "challenge_lines",
          "evidence_count",
          "evidence_lines",
          "evidence_tier",
          "outcome_claim"
        ]
      }
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 600,
            "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
          }
        },
        "revision_hint": {
          "type": "string",
          "maxLength": 600,
          "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ARCHIVE-1"
            ]
          }
        }
      },
      "$comment": "Echo limits and the rules this DP may cite, set here because the shared property shapes must match schemas/dp-output.schema.json. The personal-data pattern on reasons, revision_hint and every hint or reason string rejects an at sign (also full-width), a scheme separator, www., http and a run of 7 or more digits with separators."
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "publish"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "confidence",
          "residual_personal_data",
          "failures_explained",
          "blocked_explained"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "const": "ARCHIVE-1"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.9
          },
          "residual_personal_data": {
            "const": false
          },
          "failures_explained": {
            "const": true
          },
          "blocked_explained": {
            "const": true
          },
          "missing": false,
          "revision_hint": false,
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "needs_revision"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "revision_hint",
          "confidence",
          "residual_personal_data",
          "missing"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "const": "ARCHIVE-1"
            }
          },
          "revision_hint": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0.75
          },
          "residual_personal_data": {
            "const": false
          },
          "failures_explained": true,
          "blocked_explained": true,
          "missing": true,
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": true,
          "missing": false,
          "revision_hint": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "missing_input"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "missing_inputs",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "enum": [
              "ambiguous_input",
              "cannot_decide"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "residual_personal_data"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "residual_personal_data",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "residual_personal_data": {
            "const": true
          },
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "residual_personal_data"
        ],
        "properties": {
          "residual_personal_data": {
            "const": true
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "hold_reason": {
            "const": "residual_personal_data"
          }
        }
      }
    }
  ]
}
