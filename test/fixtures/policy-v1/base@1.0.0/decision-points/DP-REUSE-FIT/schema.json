{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "can_policy/decision-points/DP-REUSE-FIT/schema.json",
  "$comment": "Extends schemas/dp-output.schema.json: the shared keys are unchanged except outcome, which is narrowed. Unsafe outputs are unrepresentable: publish (show the suggestion) needs REUSE-CONTEXT-1 and REUSE-CREDIT-1, confidence 0.85 or more, credited_sources, differences_shown and unusable_stages lists, adaptations, auto_adopt false, review_still_required true and archive_used_as_review false; a suggestion is never adopted here. The model never decides legality. JSON Schema cannot compare against the input: the handler checks that credited_sources equals the input source refs exactly, that differences_shown equals every input difference whose relation is close or different (every difference when stale_versions is yes), that unusable_stages equals exactly the stages whose legality is unlawful_at_L0 to unlawful_at_L6, that every adaptation stage_ref is an input stage with legality lawful or unlawful, that an unlawful stage carries only an adaptation whose analogue_ref is an input analogue line for that stage, that a publish is refused when legal_stack is not resolved, corpus_status is not complete, attribution is not present or a stage has legality unknown, and that confidence does not exceed confidence_ceiling; any mismatch is a hold (see eval/README.md).",
  "title": "DP-REUSE-FIT output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "rule_ids",
    "confidence",
    "reasons"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "publish",
        "needs_revision",
        "hold"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "revision_hint": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "adaptations": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_ref",
          "kind",
          "reason"
        ],
        "properties": {
          "stage_ref": {
            "type": "string",
            "pattern": "^s-[0-9]{1,3}$"
          },
          "kind": {
            "enum": [
              "substitute",
              "scale_down",
              "add_institution_step",
              "drop_step"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
          },
          "analogue_ref": {
            "type": "string",
            "pattern": "^a-[0-9]{1,3}$"
          }
        }
      }
    },
    "unusable_stages": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^s-[0-9]{1,3}$"
      }
    },
    "differences_shown": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^d-[0-9]{1,3}$"
      }
    },
    "credited_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^r-[0-9]{1,3}$"
      }
    },
    "auto_adopt": {
      "type": "boolean"
    },
    "review_still_required": {
      "type": "boolean"
    },
    "archive_used_as_review": {
      "type": "boolean"
    },
    "hold_reason": {
      "enum": [
        "missing_input",
        "ambiguous_input",
        "legality_unchecked",
        "cannot_decide"
      ]
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "jurisdiction",
          "legal_stack",
          "corpus_status",
          "confidence_ceiling",
          "attribution",
          "stale_versions",
          "source_count",
          "source_lines",
          "stage_count",
          "stage_lines",
          "difference_count",
          "difference_lines",
          "draft"
        ]
      }
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 600,
            "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
          }
        },
        "revision_hint": {
          "type": "string",
          "maxLength": 600,
          "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REUSE-CONTEXT-1",
              "REUSE-CREDIT-1"
            ]
          }
        },
        "review_still_required": {
          "const": true
        },
        "archive_used_as_review": {
          "const": false
        },
        "auto_adopt": {
          "const": false
        }
      },
      "$comment": "Echo limits and the rules this DP may cite, set here because the shared property shapes must match schemas/dp-output.schema.json. The personal-data pattern on reasons, revision_hint and every hint or reason string rejects an at sign (also full-width), a scheme separator, www., http and a run of 7 or more digits with separators."
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "publish"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "confidence",
          "adaptations",
          "unusable_stages",
          "differences_shown",
          "credited_sources",
          "auto_adopt",
          "review_still_required",
          "archive_used_as_review"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "allOf": [
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "REUSE-CONTEXT-1"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "REUSE-CREDIT-1"
                }
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.85
          },
          "adaptations": true,
          "unusable_stages": true,
          "differences_shown": true,
          "credited_sources": true,
          "auto_adopt": {
            "const": false
          },
          "review_still_required": {
            "const": true
          },
          "archive_used_as_review": {
            "const": false
          },
          "revision_hint": false,
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "needs_revision"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "revision_hint",
          "confidence",
          "auto_adopt",
          "review_still_required",
          "archive_used_as_review"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "const": "REUSE-CONTEXT-1"
            }
          },
          "revision_hint": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0.75
          },
          "adaptations": false,
          "unusable_stages": true,
          "differences_shown": true,
          "credited_sources": true,
          "auto_adopt": {
            "const": false
          },
          "review_still_required": {
            "const": true
          },
          "archive_used_as_review": {
            "const": false
          },
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": true,
          "adaptations": false,
          "unusable_stages": false,
          "differences_shown": false,
          "credited_sources": false,
          "revision_hint": false,
          "auto_adopt": {
            "const": false
          },
          "archive_used_as_review": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "missing_input"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "missing_inputs",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "enum": [
              "ambiguous_input",
              "legality_unchecked",
              "cannot_decide"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": false
        }
      }
    }
  ]
}
