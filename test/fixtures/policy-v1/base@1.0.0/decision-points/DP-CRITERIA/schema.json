{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "can_policy/decision-points/DP-CRITERIA/schema.json",
  "$comment": "Extends schemas/dp-output.schema.json: the shared keys are unchanged except outcome, which is narrowed. Unsafe outputs are unrepresentable: publish needs every criterion measurable, lawful yes and fitting, at 0.90 or more; reject needs an unlawful criterion plus a constrains finding with article id and corpus version, at 0.92 or more, so vagueness can never reject; conflicts and missing legal layers force hold. No auto-pass. When publish carries legal_findings it must hold one item per layer L1 to L6. JSON Schema cannot count inputs or compare refs to the input: the handler checks that output refs equal input refs exactly (see eval/README.md).",
  "title": "DP-CRITERIA output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "rule_ids",
    "confidence",
    "reasons"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "publish",
        "needs_revision",
        "reject",
        "hold"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "revision_hint": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "per_criterion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "measurable",
          "lawful",
          "fits"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "measurable": {
            "type": "boolean"
          },
          "lawful": {
            "enum": [
              "yes",
              "no",
              "not_judged"
            ]
          },
          "fits": {
            "type": "boolean"
          },
          "hint": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "uniqueItems": true
    },
    "legal_findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "finding"
        ],
        "properties": {
          "layer": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3",
              "L4",
              "L5",
              "L6"
            ]
          },
          "article_id": {
            "type": "string",
            "maxLength": 80
          },
          "corpus_version": {
            "type": "string",
            "maxLength": 64
          },
          "finding": {
            "enum": [
              "constrains",
              "permits",
              "none_found",
              "conflict"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "required": [
                "layer"
              ],
              "properties": {
                "layer": {
                  "enum": [
                    "L1",
                    "L2",
                    "L3",
                    "L4",
                    "L5",
                    "L6"
                  ]
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "corpus_version"
              ],
              "properties": {
                "corpus_version": true
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "layer",
                "finding"
              ],
              "properties": {
                "layer": {
                  "enum": [
                    "L1",
                    "L2",
                    "L3",
                    "L4",
                    "L5",
                    "L6"
                  ]
                },
                "finding": {
                  "enum": [
                    "constrains",
                    "permits",
                    "conflict"
                  ]
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "article_id"
              ],
              "properties": {
                "article_id": true
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "layer"
              ],
              "properties": {
                "layer": {
                  "const": "L0"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "article_id": false,
                "corpus_version": false,
                "finding": {
                  "const": "none_found"
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "finding"
              ],
              "properties": {
                "finding": {
                  "const": "none_found"
                }
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "article_id": false
              }
            }
          }
        ]
      }
    },
    "hold_reason": {
      "enum": [
        "missing_input",
        "layer_conflict",
        "ambiguous_input",
        "cannot_decide"
      ]
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "enum": [
          "criteria",
          "criterion_count",
          "desired_outcome",
          "stage_goal",
          "scope",
          "jurisdiction",
          "legal_layer"
        ]
      }
    },
    "conflict_note": {
      "type": "string",
      "maxLength": 300
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 600
          }
        },
        "revision_hint": {
          "type": "string",
          "maxLength": 600
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "CRITERIA-1",
              "LEGAL-STACK-1",
              "LEGAL-CITE-1"
            ]
          }
        }
      },
      "$comment": "Echo limits and the rules this DP may cite, set here because the shared property shapes must match schemas/dp-output.schema.json."
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "publish"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "per_criterion",
          "confidence"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "const": "CRITERIA-1"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.9
          },
          "per_criterion": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "measurable",
                "lawful",
                "fits"
              ],
              "properties": {
                "measurable": {
                  "const": true
                },
                "lawful": {
                  "const": "yes"
                },
                "fits": {
                  "const": true
                }
              }
            }
          },
          "legal_findings": {
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "required": [
                  "finding"
                ],
                "properties": {
                  "finding": {
                    "enum": [
                      "constrains",
                      "conflict"
                    ]
                  }
                }
              }
            },
            "type": "array",
            "allOf": [
              {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "layer"
                  ],
                  "properties": {
                    "layer": {
                      "const": "L1"
                    }
                  }
                }
              },
              {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "layer"
                  ],
                  "properties": {
                    "layer": {
                      "const": "L2"
                    }
                  }
                }
              },
              {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "layer"
                  ],
                  "properties": {
                    "layer": {
                      "const": "L3"
                    }
                  }
                }
              },
              {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "layer"
                  ],
                  "properties": {
                    "layer": {
                      "const": "L4"
                    }
                  }
                }
              },
              {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "layer"
                  ],
                  "properties": {
                    "layer": {
                      "const": "L5"
                    }
                  }
                }
              },
              {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "layer"
                  ],
                  "properties": {
                    "layer": {
                      "const": "L6"
                    }
                  }
                }
              }
            ]
          },
          "revision_hint": false,
          "hold_reason": false,
          "missing_inputs": false,
          "conflict_note": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "needs_revision"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "revision_hint",
          "confidence"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "const": "CRITERIA-1"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0.75
          },
          "per_criterion": {
            "type": "array",
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "required": [
                  "lawful"
                ],
                "properties": {
                  "lawful": {
                    "const": "no"
                  }
                }
              }
            }
          },
          "legal_findings": {
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "required": [
                  "finding"
                ],
                "properties": {
                  "finding": {
                    "const": "conflict"
                  }
                }
              }
            }
          },
          "hold_reason": false,
          "missing_inputs": false,
          "conflict_note": false,
          "revision_hint": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "reject"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "per_criterion",
          "legal_findings",
          "confidence"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "allOf": [
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "CRITERIA-1"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "LEGAL-STACK-1"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "LEGAL-CITE-1"
                }
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.92
          },
          "per_criterion": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "lawful"
              ],
              "properties": {
                "lawful": {
                  "const": "no"
                }
              }
            }
          },
          "legal_findings": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "finding",
                "article_id",
                "corpus_version"
              ],
              "properties": {
                "finding": {
                  "const": "constrains"
                },
                "article_id": {
                  "type": "string"
                },
                "corpus_version": {
                  "type": "string"
                }
              }
            },
            "not": {
              "type": "array",
              "contains": {
                "type": "object",
                "required": [
                  "finding"
                ],
                "properties": {
                  "finding": {
                    "const": "conflict"
                  }
                }
              }
            }
          },
          "revision_hint": false,
          "hold_reason": false,
          "missing_inputs": false,
          "conflict_note": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "missing_input"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "missing_inputs",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "layer_conflict"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "conflict_note",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": false,
          "conflict_note": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "enum": [
              "ambiguous_input",
              "cannot_decide"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": false,
          "conflict_note": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "legal_findings"
        ],
        "properties": {
          "legal_findings": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "finding"
              ],
              "properties": {
                "finding": {
                  "const": "conflict"
                }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "outcome",
          "conflict_note"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "conflict_note": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "legal_findings"
        ],
        "properties": {
          "legal_findings": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "layer"
              ],
              "properties": {
                "layer": {
                  "const": "L0"
                }
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "rule_ids"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "contains": {
              "enum": [
                "LEGAL-STACK-1",
                "LEGAL-CITE-1"
              ]
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "legal_findings"
        ],
        "properties": {
          "legal_findings": true
        }
      }
    }
  ]
}
