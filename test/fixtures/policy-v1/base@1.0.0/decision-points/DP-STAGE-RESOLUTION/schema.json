{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "can_policy/decision-points/DP-STAGE-RESOLUTION/schema.json",
  "$comment": "Extends schemas/dp-output.schema.json: the shared keys are unchanged except outcome, which is narrowed. Unsafe outputs are unrepresentable: publish (the stage resolves) needs STAGE-RESOLVE-1 and STAGE-GATE-1, confidence 0.90 or more, choice_gate_ok true and a per_criterion list in which every item is met with at least one evidence id; needs_revision needs a hint, 0.75 or more and either an unmet criterion or an open choice gate; missing, conflicting or unreadable input is a hold. There is no reject outcome and no auto-pass. JSON Schema cannot count criteria or compare refs to the input: the handler checks that the per_criterion refs equal the input criterion refs exactly, each once, that every evidence id of a met item is an input evidence item with source_trust establishes and dated after_start, and that the trigger equals the input trigger; any mismatch is a hold (see eval/README.md). An unmet item (met false) may list evidence_ids: they are the evidence the DP judged and found wanting (off_topic, untrusted_source, before_stage_start, partly_met), and its hint cites them; only a met item must have at least one, and an unmet item never counts toward publish.",
  "title": "DP-STAGE-RESOLUTION output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "rule_ids",
    "confidence",
    "reasons"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "publish",
        "needs_revision",
        "hold"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "revision_hint": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trigger": {
      "enum": [
        "evidence_submit",
        "rule_change"
      ]
    },
    "choice_gate_ok": {
      "type": "boolean"
    },
    "per_criterion": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_ref",
          "met",
          "evidence_ids"
        ],
        "properties": {
          "criterion_ref": {
            "type": "string",
            "pattern": "^c-[0-9]{1,3}$"
          },
          "met": {
            "type": "boolean"
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^e-[0-9]{1,3}$"
            }
          },
          "gap": {
            "enum": [
              "not_addressed",
              "restates_criterion",
              "off_topic",
              "before_stage_start",
              "poster_say_so_only",
              "untrusted_source",
              "criterion_vague",
              "partly_met"
            ]
          },
          "hint": {
            "type": "string",
            "maxLength": 300
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "required": [
                "met"
              ],
              "properties": {
                "met": {
                  "const": true
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "evidence_ids"
              ],
              "properties": {
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1
                },
                "gap": false
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "met"
              ],
              "properties": {
                "met": {
                  "const": false
                }
              }
            },
            "then": {
              "type": "object",
              "required": [
                "gap",
                "hint"
              ],
              "properties": {
                "gap": true,
                "hint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "hold_reason": {
      "enum": [
        "missing_input",
        "ambiguous_input",
        "cannot_decide"
      ]
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "jurisdiction",
          "trigger",
          "stage_state",
          "predecessors",
          "choice_gate",
          "choice",
          "criteria_count",
          "criteria",
          "evidence_count",
          "evidence_lines",
          "evidence_tier",
          "source_trust",
          "poster_statement"
        ]
      }
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 600
          }
        },
        "revision_hint": {
          "type": "string",
          "maxLength": 600
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "STAGE-RESOLVE-1",
              "STAGE-GATE-1"
            ]
          }
        }
      },
      "$comment": "Echo limits and the rules this DP may cite, set here because the shared property shapes must match schemas/dp-output.schema.json."
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "publish"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "confidence",
          "trigger",
          "choice_gate_ok",
          "per_criterion"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "allOf": [
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "STAGE-RESOLVE-1"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "STAGE-GATE-1"
                }
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.9
          },
          "trigger": true,
          "choice_gate_ok": {
            "const": true
          },
          "per_criterion": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "met"
              ],
              "properties": {
                "met": {
                  "const": true
                }
              }
            }
          },
          "revision_hint": false,
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "needs_revision"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "revision_hint",
          "confidence",
          "trigger",
          "choice_gate_ok"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "const": "STAGE-RESOLVE-1"
            }
          },
          "revision_hint": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0.75
          },
          "trigger": true,
          "choice_gate_ok": true,
          "per_criterion": true,
          "hold_reason": false,
          "missing_inputs": false
        },
        "anyOf": [
          {
            "type": "object",
            "required": [
              "per_criterion"
            ],
            "properties": {
              "per_criterion": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "met"
                  ],
                  "properties": {
                    "met": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "choice_gate_ok"
            ],
            "properties": {
              "choice_gate_ok": {
                "const": false
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": true,
          "per_criterion": false,
          "choice_gate_ok": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "missing_input"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "missing_inputs",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "enum": [
              "ambiguous_input",
              "cannot_decide"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": false
        }
      }
    }
  ]
}
