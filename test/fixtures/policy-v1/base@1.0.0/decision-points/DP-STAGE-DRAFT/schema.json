{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "can_policy/decision-points/DP-STAGE-DRAFT/schema.json",
  "$comment": "Extends schemas/dp-output.schema.json: the shared keys are unchanged except outcome, which is narrowed. Unsafe outputs are unrepresentable: a draft is only offered (publish) with REUSE-CREDIT-1 and REUSE-NOBLOCK-1, confidence 0.85 or more, a draft_plan whose every stage names its source stages (derived_from) and the final criteria it covers, credited_suggestions, skipped_source_stages, an empty uncovered_final_criteria, draft_only true, review_still_required true and archive_used_as_review false; the DP never publishes a plan. JSON Schema cannot compare against the input: the handler checks that every derived_from ref is an input source stage with legality lawful and without an accepted drop_step adaptation, that skipped_source_stages equals exactly the input source stages whose legality is not lawful (a drop_step stage is neither used nor skipped), that credited_suggestions equals the suggestions of the used source stages, that draft stage names are unique and depends_on names resolve to earlier draft stages, that uncovered_final_criteria equals the input final criteria that no draft stage covers (and every covers ref is an input final ref), and that a publish is refused when legal_stack is not resolved, a credit is absent or final_count is 0; any mismatch is a hold (see eval/README.md).",
  "title": "DP-STAGE-DRAFT output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "rule_ids",
    "confidence",
    "reasons"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "publish",
        "needs_revision",
        "hold"
      ]
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "field_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "revision_hint": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "goal",
          "criteria",
          "derived_from",
          "covers",
          "auto_start"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "goal": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "measure"
              ],
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 300,
                  "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
                },
                "measure": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 300,
                  "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
                }
              }
            }
          },
          "decision_method": {
            "const": "poster_after_input"
          },
          "depends_on": {
            "type": "array",
            "maxItems": 11,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,39}$"
            }
          },
          "derived_from": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^t-[0-9]{1,3}$"
            }
          },
          "covers": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^f-[0-9]{1,3}$"
            }
          },
          "auto_start": {
            "const": true
          }
        }
      }
    },
    "credited_suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^g-[0-9]{1,3}$"
      }
    },
    "skipped_source_stages": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^t-[0-9]{1,3}$"
      }
    },
    "uncovered_final_criteria": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^f-[0-9]{1,3}$"
      }
    },
    "draft_only": {
      "type": "boolean"
    },
    "review_still_required": {
      "type": "boolean"
    },
    "archive_used_as_review": {
      "type": "boolean"
    },
    "hold_reason": {
      "enum": [
        "missing_input",
        "ambiguous_input",
        "legality_unchecked",
        "cannot_decide"
      ]
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "enum": [
          "jurisdiction",
          "trigger",
          "problem_state",
          "legal_stack",
          "suggestion_count",
          "suggestion_lines",
          "source_stage_count",
          "source_stage_lines",
          "adaptation_count",
          "adaptation_lines",
          "final_count",
          "final_criteria",
          "problem",
          "attribution"
        ]
      }
    }
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "reasons": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "maxLength": 600,
            "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
          }
        },
        "revision_hint": {
          "type": "string",
          "maxLength": 600,
          "pattern": "^(?![\\s\\S]*(?:@|＠|://|[Ww][Ww][Ww]\\.|[Hh][Tt][Tt][Pp]))(?![\\s\\S]*\\p{Nd}(?:[ .()+\\-/]*\\p{Nd}){6})[\\s\\S]*$"
        },
        "rule_ids": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REUSE-CREDIT-1",
              "REUSE-NOBLOCK-1"
            ]
          }
        },
        "review_still_required": {
          "const": true
        },
        "archive_used_as_review": {
          "const": false
        },
        "draft_only": {
          "const": true
        }
      },
      "$comment": "Echo limits and the rules this DP may cite, set here because the shared property shapes must match schemas/dp-output.schema.json. The personal-data pattern on reasons, revision_hint and every hint or reason string rejects an at sign (also full-width), a scheme separator, www., http and a run of 7 or more digits with separators."
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "publish"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "confidence",
          "draft_plan",
          "credited_suggestions",
          "skipped_source_stages",
          "uncovered_final_criteria",
          "draft_only",
          "review_still_required",
          "archive_used_as_review"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "allOf": [
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "REUSE-CREDIT-1"
                }
              },
              {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "const": "REUSE-NOBLOCK-1"
                }
              }
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.85
          },
          "draft_plan": true,
          "credited_suggestions": true,
          "skipped_source_stages": true,
          "uncovered_final_criteria": {
            "type": "array",
            "maxItems": 0
          },
          "draft_only": {
            "const": true
          },
          "review_still_required": {
            "const": true
          },
          "archive_used_as_review": {
            "const": false
          },
          "revision_hint": false,
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "needs_revision"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "rule_ids",
          "revision_hint",
          "confidence",
          "uncovered_final_criteria",
          "skipped_source_stages",
          "draft_only",
          "review_still_required",
          "archive_used_as_review"
        ],
        "properties": {
          "rule_ids": {
            "type": "array",
            "minItems": 1
          },
          "revision_hint": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0.75
          },
          "uncovered_final_criteria": true,
          "skipped_source_stages": true,
          "credited_suggestions": false,
          "draft_plan": false,
          "draft_only": {
            "const": true
          },
          "review_still_required": {
            "const": true
          },
          "archive_used_as_review": {
            "const": false
          },
          "hold_reason": false,
          "missing_inputs": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": true,
          "draft_plan": false,
          "credited_suggestions": false,
          "skipped_source_stages": false,
          "uncovered_final_criteria": false,
          "revision_hint": false,
          "draft_only": {
            "const": true
          },
          "archive_used_as_review": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "const": "missing_input"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "missing_inputs",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": true
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "hold_reason"
        ],
        "properties": {
          "hold_reason": {
            "enum": [
              "ambiguous_input",
              "legality_unchecked",
              "cannot_decide"
            ]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "hold"
          },
          "missing_inputs": false
        }
      }
    }
  ]
}
