{
  "$id": "fixture.problem",
  "x-version": "2.0.0",
  "type": "object",
  "required": [
    "title",
    "statement",
    "reach",
    "who_affected"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120,
      "x-ui": {
        "widget": "text",
        "label_msg": "schema.problem.title.label",
        "help_msg": "schema.problem.title.help",
        "order": 1
      },
      "x-guidance": {
        "why": "A short public name for the condition.",
        "good": "Unlit crossing near the Fiktiva City market",
        "bad": "Mr. X ignores us",
        "maxLength": 120
      },
      "x-checks": {
        "dps": [
          "DP-NAMING"
        ]
      }
    },
    "statement": {
      "type": "string",
      "maxLength": 900
    },
    "reach": {
      "type": "string",
      "enum": [
        "street",
        "district",
        "city"
      ]
    },
    "who_affected": {
      "type": "string",
      "maxLength": 200
    }
  }
}
