{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://can.invalid/schemas/seed.schema.json",
  "title": "Simulation seed (simulation/seeds/<id>/seed.yaml). Real framing, synthetic evidence (D-56, D-78).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "number", "framing", "jurisdiction", "label", "problem", "evidence", "rubric", "stage_plan", "variants", "personas"],
  "properties": {
    "id": { "type": "string", "pattern": "^seed-[0-9]+(-[a-z0-9]+)+$" },
    "number": { "type": "integer", "minimum": 1, "maximum": 4 },
    "framing": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "label": { "const": "Seed problem, synthetic evidence" },
    "problem": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$" },
    "rubric": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
    "stage_plan": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.json$" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "description", "tier_cap", "synthetic"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "url": { "type": "string", "pattern": "^https://evidence\\.sim\\.test/" },
          "description": { "type": "string", "minLength": 1 },
          "tier_cap": { "type": "integer", "minimum": 0 },
          "synthetic": { "const": true }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["happy", "revise", "appeal", "stuck_or_blocked", "plan_change", "attack_wave", "parallel_stages", "reuse"] }
    },
    "personas": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
