{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://can.invalid/schemas/persona.schema.json",
  "title": "Simulation persona (simulation/personas/<id>/persona.yaml). Synthetic only, never credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "role", "goals", "knowledge", "flaws", "behaviors", "language", "turn_budget", "seed", "synthetic", "handle", "script", "expected"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+(-[a-z0-9]+)+$" },
    "family": { "enum": ["submitter", "contributor", "adversarial", "volunteer", "stage", "reuser"] },
    "role": { "type": "string", "minLength": 1 },
    "goals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "knowledge": { "type": "string", "minLength": 1 },
    "flaws": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "behaviors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "turn_budget": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer" },
    "synthetic": { "const": true },
    "handle": { "type": "string", "pattern": "^sim-[a-z0-9-]+$" },
    "location": { "enum": ["inside", "outside", "none", "travelling"] },
    "script": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
    "prompt": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
    "attack_goal": { "type": "string", "minLength": 1 },
    "pass_condition": { "type": "string", "minLength": 1 },
    "attack_data": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.jsonl$" },
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "outcomes"],
        "properties": {
          "step_id": { "type": "string", "minLength": 1 },
          "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z_]+$" } },
          "dp": { "type": "string", "pattern": "^DP-[A-Z-]+$" },
          "rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "if": { "type": "object", "properties": { "family": { "const": "adversarial" } }, "required": ["family"] },
  "then": { "type": "object", "properties": { "attack_goal": true, "pass_condition": true }, "required": ["attack_goal", "pass_condition"] }
}
