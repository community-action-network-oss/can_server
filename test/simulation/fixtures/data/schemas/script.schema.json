{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://can.invalid/schemas/script.schema.json",
  "title": "Persona script (script.json). Declarative: placeholders {{seed.<field>}} and {{var.<name>}} are resolved by the harness; no code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps"],
  "properties": {
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "after_step": { "type": "string", "minLength": 1 },
            "outcome_was": { "type": "string", "pattern": "^[a-z_]+$" }
          }
        },
        "action": {
          "enum": ["prepare", "request_review", "recommend", "resolve_recommendation", "request_publication", "submit", "contribute", "revise", "appeal", "read", "assist", "start_stage", "stage_option", "choose", "stage_evidence", "plan_change", "suggestions", "accept_suggestion", "attest", "stop", "raw_http"]
        },
        "content_type": { "type": "string", "pattern": "^[a-z_.]+$" },
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "fields": { "type": "object" },
        "assumption_strategy": { "enum": ["mark_assumption", "correct", "ignore"] },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcome": { "type": "string", "pattern": "^[a-z_]+$" },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "rule_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "field_ref": { "type": "string", "minLength": 1 }
          }
        },
        "raw_http": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "pattern": "^/" },
            "body": {}
          }
        }
      },
      "if": { "type": "object", "properties": { "action": { "const": "raw_http" } }, "required": ["action"] },
      "then": { "type": "object", "properties": { "raw_http": true }, "required": ["raw_http"] },
      "else": { "type": "object", "properties": { "raw_http": false } }
    }
  }
}
