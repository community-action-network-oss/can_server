          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_end_to_end_before_round2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "g7_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
