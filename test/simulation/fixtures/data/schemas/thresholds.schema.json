      ],
      "properties": {
        "min_pass_within_2_rounds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "g8_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_appeals",
        "min_overturned",
        "overturn_became_ratified_example",
        "max_resolution_time_hours"
      ],
      "properties": {
        "min_appeals": {
          "type": "integer",
          "minimum": 1
        },
        "min_overturned": {
          "type": "integer",
          "minimum": 1
        },
        "overturn_became_ratified_example": {
          "const": true
        },
        "max_resolution_time_hours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "g9_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_triggers_per_matrix_row",
        "max_publishes_on_failure",
        "reply_allowance"
      ],
      "properties": {
        "min_triggers_per_matrix_row": {
          "type": "integer",
          "minimum": 1
        },
        "max_publishes_on_failure": {
          "type": "integer",
          "minimum": 0
        },
        "reply_allowance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limit_source",
            "min_over_limit_attempts",
            "max_over_limit_accepted",
            "expected_outcome"
          ],
          "properties": {
            "limit_source": {
              "const": "limits.yaml#caps.replies_per_account_per_problem_per_day"
            },
            "min_over_limit_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_over_limit_accepted": {
              "type": "integer",
              "minimum": 0
            },
            "expected_outcome": {
              "const": "reply_limit_reached"
            }
          }
        }
      }
    },
    "g10_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_shadow_to_full_rollouts",
        "min_rollbacks"
      ],
      "properties": {
        "min_shadow_to_full_rollouts": {
          "type": "integer",
          "minimum": 1
        },
        "min_rollbacks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "g11_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_gap"
      ],
      "properties": {
        "max_gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "g12_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "founder_cap_usd",
        "max_cost_per_accepted_result",
        "never_exceed_cap"
      ],
      "properties": {
        "founder_cap_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_cost_per_accepted_result": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "never_exceed_cap": {
          "const": true
        }
      }
    },
    "g13_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratification_record_for_exact_versions"
      ],
      "properties": {
        "ratification_record_for_exact_versions": {
          "const": true
        }
      }
    }
