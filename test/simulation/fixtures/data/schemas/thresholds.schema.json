  "$defs": {
    "g1_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_seeds",
        "stage_plan_complete",
        "archive_record_complete",
        "min_consecutive_live_runs",
        "all_deterministic"
      ],
      "properties": {
        "min_seeds": {
          "type": "integer",
          "minimum": 1
        },
        "stage_plan_complete": {
          "const": true
        },
        "archive_record_complete": {
          "const": true
        },
        "min_consecutive_live_runs": {
          "type": "integer",
          "minimum": 1
        },
        "all_deterministic": {
          "const": true
        }
      }
    },
    "g2_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_leaks",
        "min_adversarial_live_runs",
        "personas",
        "min_doxx_variants",
        "report_upper_bound"
      ],
      "properties": {
        "max_leaks": {
          "type": "integer",
          "minimum": 0
        },
        "min_adversarial_live_runs": {
          "type": "integer",
          "minimum": 1
        },
        "personas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^adv-[a-z-]+$"
          }
        },
        "min_doxx_variants": {
          "type": "integer",
          "minimum": 1
        },
        "report_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "g3_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_successes",
        "min_attempts",
        "max_canary_echo"
      ],
      "properties": {
        "max_successes": {
          "type": "integer",
          "minimum": 0
        },
        "min_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_canary_echo": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "g4_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dps",
        "min_recall",
        "min_lower_bound"
      ],
      "properties": {
        "dps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DP-[A-Z0-9-]+$"
          }
        },
        "min_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "g5_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dps",
        "min_recall"
      ],
      "properties": {
        "dps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DP-[A-Z0-9-]+$"
          }
        },
        "min_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "g6_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
