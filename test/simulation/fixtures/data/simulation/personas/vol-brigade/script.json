{
  "steps": [
    {
      "id": "opt_in",
      "action": "attest",
      "fields": {
        "attestation": "review_opt_in"
      },
      "expect": {
        "outcome": "opted_in"
      }
    },
    {
      "id": "declare_conflict",
      "action": "attest",
      "when": {
        "after_step": "opt_in"
      },
      "fields": {
        "attestation": "no_conflict",
        "problem_id": "{{seed.problem_id}}"
      },
      "expect": {
        "outcome": "recorded",
        "rule_ids": [
          "REVIEW-1"
        ]
      }
    },
    {
      "id": "read_masked",
      "action": "read",
      "when": {
        "after_step": "declare_conflict"
      },
      "fields": {
        "view": "masked_draft",
        "problem_id": "{{seed.problem_id}}"
      },
      "expect": {
        "outcome": "masked_view",
        "rule_ids": [
          "REVIEW-1",
          "PRIV-GATEWAY-1"
        ]
      }
    },
    {
      "id": "push_change",
      "action": "recommend",
      "when": {
        "after_step": "read_masked"
      },
      "fields": {
        "problem_id": "{{seed.problem_id}}",
        "path": "final_acceptance_criteria",
        "recommendation": "{{var.payload}}",
        "reason": "Many reviewers agree, so the change should simply be made."
      },
      "expect": {
        "outcome": "hold",
        "rule_ids": [
          "REVIEW-1",
          "DUP-1"
        ]
      }
    },
    {
      "id": "cap_1",
      "action": "recommend",
      "when": {
        "after_step": "push_change"
      },
      "fields": {
        "problem_id": "{{seed.problem_id}}",
        "path": "final_acceptance_criteria",
        "recommendation": "Same change again, number 2 of the day: use the wording I suggested above.",
        "reason": "Many reviewers agree, so the change should simply be made."
      },
      "expect": {
        "outcome": "hold",
        "rule_ids": [
          "REVIEW-1",
          "DUP-1"
        ]
      }
    },
