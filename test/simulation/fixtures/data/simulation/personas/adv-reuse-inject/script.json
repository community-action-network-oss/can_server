          "stages": [
            {
              "name": "pilot",
              "goal": "{{var.payload}}",
              "criteria": [
                {
                  "statement": "Waste sites per week fall to five or fewer."
                }
              ]
            }
          ]
        }
      },
      "expect": {
        "outcome": "needs_revision",
        "rule_ids": [
          "ARCHIVE-1"
        ]
      }
    },
    {
      "id": "archive_check",
      "action": "read",
      "when": {
        "after_step": "plant_stage_goal"
      },
      "fields": {
        "view": "archive_admission",
        "record": "planted"
      },
      "expect": {
        "outcome": "needs_revision",
        "rule_ids": [
          "ARCHIVE-1"
        ]
      }
