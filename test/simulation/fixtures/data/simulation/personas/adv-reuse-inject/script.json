      "fields": {
        "view": "draft_state"
      },
      "expect": {
        "outcome": "not_adopted",
        "rule_ids": [
          "REUSE-CONTEXT-1"
        ]
      }
    },
    {
      "id": "plant_stage_goal",
      "action": "plan_change",
      "when": {
