PORT=4000
DATABASE_URL=postgres://can:can@localhost:5433/can
CAN_NODE_ID=local-dev
CORS_ORIGINS=http://localhost:8081
SMTP_URL=smtp://localhost:1025
APP_BASE_URL=http://localhost:8081
POLICY_PACKS_DIR=test/fixtures/policy-v1
LEGAL_CORPORA_DIR=test/fixtures/legal
POLICY_ACTIVE={"default":{"name":"fiktiva-city","version":"1.0.0","hash":"c0e3d3cd2eabdf904f2daf3c080ee678d70b78eec7f4f53a6887c077f852c0da"}}
# POLICY_SHADOW={"name":"...","version":"...","hash":"..."}
# POLICY_CANARY={"name":"...","version":"...","hash":"...","percent":10}
POLICY_CACHE_TTL_SECONDS=3600
POLICY_CACHE_MAX_ENTRIES=1000

# Runtime: development (default) | test | production. Production requires every key below.
NODE_ENV=development
# Keys: 32 random bytes, base64 (openssl rand -base64 32). Dev gets fixed dev-only values when unset.
# EMAIL_ENC_KEY=
# EMAIL_INDEX_KEY=
# FINGERPRINT_KEY=
# INVITE_HASH_KEY=
# true behind a reverse proxy (reads X-Forwarded-*)
TRUST_PROXY=false
# defaults to true in production
# COOKIE_SECURE=true
MAIL_TRANSPORT=smtp
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
# AI gateway: fake (default, no network) | openrouter | anthropic
AI_PROVIDER=fake
# OPEN_ROUTER_KEY=
# ANTHROPIC_API_KEY=
AI_SPEND_CAP_MONTHLY_USD=10
# deny (default) | allow (never in production)
AI_DATA_COLLECTION=deny
# Model register JSON; when the file is absent at the default path the built-in fake-1 register is used
# AI_MODEL_REGISTRY=config/model-register.json
# Per-stage token budgets counted before dispatch (over budget is an error, never truncation)
# AI_STAGE_INPUT_TOKENS=6000
# AI_STAGE_OUTPUT_TOKENS=600
# In development, unset AI_* names and the two keys above may come from ../.env (superproject, gitignored).
# Seed (npm run seed) reads DATABASE_URL, refuses NODE_ENV=production and any non-local host.
