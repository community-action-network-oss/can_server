{
  "components": {
    "schemas": {
      "CodeRequestedDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ContentSchemaDto": {
        "properties": {
          "messages": {
            "additionalProperties": true,
            "description": "Parsed messages.en.json for this type",
            "type": "object"
          },
          "policy_version": {
            "type": "string"
          },
          "schema": {
            "additionalProperties": true,
            "description": "JSON Schema with x-ui, x-guidance, x-checks",
            "type": "object"
          },
          "schema_hash": {
            "description": "sha256 of the schema file",
            "type": "string"
          },
          "schema_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "schema_id",
          "schema_version",
          "schema_hash",
          "policy_version",
          "messages"
        ],
        "type": "object"
      },
      "ErrorBodyDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "fieldErrors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorEnvelopeDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HandleDto": {
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "required": [
          "handle"
        ],
        "type": "object"
      },
      "HealthDto": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "down"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "db"
        ],
        "type": "object"
      },
      "MeDto": {
        "properties": {
          "handle": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "handle",
          "role"
        ],
        "type": "object"
      },
      "RequestCodeDto": {
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "SignUpDto": {
        "properties": {
          "ageConfirmed": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "inviteCode": {
            "type": "string"
          }
        },
        "required": [
          "inviteCode",
          "email",
          "ageConfirmed"
        ],
        "type": "object"
      },
      "SignUpResponseDto": {
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      },
      "VerifyDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "type": "object"
      },
      "VerifyResponseDto": {
        "properties": {
          "handle": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "token": {
            "description": "Native clients only (X-CAN-Client: native).",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "role"
        ],
        "type": "object"
      }
    }
  },
