{
  "components": {
    "schemas": {
      "CodeRequestedDto": {
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ContentSchemaDto": {
        "properties": {
          "messages": {
            "additionalProperties": true,
            "description": "Parsed messages.en.json for this type",
            "type": "object"
          },
          "policy_version": {
            "type": "string"
          },
          "schema": {
            "additionalProperties": true,
            "description": "JSON Schema with x-ui, x-guidance, x-checks",
            "type": "object"
          },
          "schema_hash": {
            "description": "sha256 of the schema file",
            "type": "string"
          },
          "schema_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "schema_id",
          "schema_version",
          "schema_hash",
          "policy_version",
          "messages"
        ],
        "type": "object"
      },
      "ErrorBodyDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "fieldErrors": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorEnvelopeDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HandleDto": {
        "properties": {
          "handle": {
            "type": "string"
          }
        },
        "required": [
          "handle"
        ],
        "type": "object"
      },
      "HealthDto": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "down"
            ],
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "db"
        ],
        "type": "object"
      },
      "HelpNeededDto": {
        "properties": {
          "coarse_place": {
            "nullable": true,
            "type": "string"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "skill_groups": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "skill_groups",
          "languages",
          "coarse_place",
          "topics"
        ],
        "type": "object"
      },
      "JurisdictionDto": {
        "properties": {
          "emergencyNotice": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "isFictional": {
            "type": "boolean"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "isFictional",
          "emergencyNotice"
        ],
        "type": "object"
      },
      "JurisdictionListDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/JurisdictionDto"
            },
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ListCriteriaDto": {
        "properties": {
          "order": {
            "enum": [
              "published_at_desc"
            ],
            "type": "string"
          },
          "usesEngagementSignals": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "order",
          "usesEngagementSignals"
        ],
        "type": "object"
      },
      "MeDto": {
        "properties": {
          "handle": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "handle",
          "role"
        ],
        "type": "object"
      },
      "PublicProblemDto": {
        "properties": {
          "coarseArea": {
            "nullable": true,
            "type": "string"
          },
          "help_needed": {
            "$ref": "#/components/schemas/HelpNeededDto"
          },
          "id": {
            "type": "string"
          },
          "investigationNeeded": {
            "type": "boolean"
          },
          "isSeed": {
            "type": "boolean"
          },
          "jurisdiction": {
            "nullable": true,
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "policyVersion": {
            "nullable": true,
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "reopened": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "syntheticEvidence": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "transitional": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "state",
          "label",
          "jurisdiction",
          "coarseArea",
          "investigationNeeded",
          "publishedAt",
          "policyVersion",
          "transitional",
          "reopened",
          "isSeed",
          "syntheticEvidence",
          "help_needed"
        ],
        "type": "object"
      },
      "PublicProblemPageDto": {
        "properties": {
          "criteria": {
            "$ref": "#/components/schemas/ListCriteriaDto"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicProblemDto"
            },
            "type": "array"
          },
          "nextCursor": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "criteria"
        ],
        "type": "object"
      },
      "RequestCodeDto": {
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "SignUpDto": {
        "properties": {
          "ageConfirmed": {
            "type": "boolean"
          },
          "email": {
            "type": "string"
          },
          "inviteCode": {
            "type": "string"
          }
        },
        "required": [
          "inviteCode",
          "email",
          "ageConfirmed"
        ],
        "type": "object"
      },
      "SignUpResponseDto": {
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted"
        ],
        "type": "object"
      },
      "VerifyDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "type": "object"
      },
      "VerifyResponseDto": {
        "properties": {
          "handle": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "token": {
            "description": "Native clients only (X-CAN-Client: native).",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "role"
        ],
        "type": "object"
      }
    }
